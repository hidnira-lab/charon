    "description": "Badge when holding traffic during reconnect.",
    "placeholders": {
      "attempt": { "type": "int" },
      "maxAttempts": { "type": "int" }
    }
  },
  "stateReconnectingHeldLine2": "try {attempt} of {maxAttempts}, next in {seconds} s, traffic held",
  "@stateReconnectingHeldLine2": {
    "description": "Subtitle showing countdown while traffic is held.",
    "placeholders": {
      "attempt": { "type": "int" },
      "maxAttempts": { "type": "int" },
