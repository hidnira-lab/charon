{
  "name": "successful connect",
  "description": "The user presses Connect with the kill switch on. Charon arms the gate, starts Xray, verifies the tunnel, and ends Up with the gate Armed. The first connect has no retry loop, and nothing here changes the quota level.",

  "config": {
    "version": 1,
    "servers": [
      {
        "id": "SRV-01",
        "display_name": "Fixture server one",
        "protocol": "PROTOCOL_VLESS_REALITY",
        "address": "192.0.2.10",
        "port": 443,
        "uuid": "00000000-0000-0000-0000-000000000001",
        "flow": "xtls-rprx-vision",
        "reality": {
          "public_key": "FIXTURE_PUBLIC_KEY_NOT_A_REAL_KEY",
          "short_id": "0000",
          "server_name": "example.com",
          "fingerprint": "chrome"
        },
        "transport": "tcp",
        "country_code": "US"
      }
    ],
    "chosen_server_id": "SRV-01",
    "settings": {
      "kill_switch": true,
      "auto_reconnect": true,
      "allow_local_network": true
    }
  },

  "saved": {
    "last_session_connected": false,
    "active_server_id": ""
  },

  "steps": [
    {
      "at_ms": 0,
      "input": { "type": "Connect" },
      "effects": [
        { "type": "SetGate", "gate": "GATE_ARMED" },
        { "type": "StartXray", "server_id": "SRV-01" }
      ],
      "expect": {
        "phase": "PHASE_STARTING",
        "gate": "GATE_ARMED",
        "active_server_id": "SRV-01",
        "chosen_server_id": "SRV-01",
        "on_backup": false
      }
    },
    {
      "at_ms": 600,
      "input": { "type": "XrayStarted" },
      "effects": [
        { "type": "StartVerify", "server_id": "SRV-01" },
        { "type": "SetTimer", "name": "verify_timeout", "after_ms": 15000 }
      ],
      "expect": {
        "phase": "PHASE_VERIFYING",
        "gate": "GATE_ARMED"
      }
    },
    {
      "at_ms": 2300,
      "input": { "type": "VerifyOk", "egress_address": "192.0.2.10", "latency_ms": 120 },
      "effects": [
        { "type": "CancelTimer", "name": "verify_timeout" },
        { "type": "SaveLastSession", "connected": true, "active_server_id": "SRV-01" }
      ],
      "expect": {
        "phase": "PHASE_UP",
        "gate": "GATE_ARMED",
        "active_server_id": "SRV-01",
        "on_backup": false,
        "egress_address": "192.0.2.10",
        "latency_ms": 120,
        "quota_level": "QUOTA_NORMAL"
      }
    }
  ]
}
