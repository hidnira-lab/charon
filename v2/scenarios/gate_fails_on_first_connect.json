{
  "name": "gate fails on first connect",
  "description": "The user presses Connect with the kill switch on, and the platform reports that the traffic gate could not be installed. Charon does not carry on with a gate it does not have: it records that no gate is in place, stops Xray and ends with 'Could not reach' and the reason gate failed. Nothing is retried, as for any first connect that fails.",

  "config": {
    "version": 1,
    "servers": [
      { "id": "SRV-01", "display_name": "Fixture server one", "protocol": "PROTOCOL_VLESS_REALITY", "address": "192.0.2.10", "port": 443, "uuid": "00000000-0000-0000-0000-000000000001", "flow": "xtls-rprx-vision", "reality": { "public_key": "FIXTURE_PUBLIC_KEY_NOT_A_REAL_KEY", "short_id": "0000", "server_name": "example.com", "fingerprint": "chrome" }, "transport": "tcp", "country_code": "US" }
    ],
    "chosen_server_id": "SRV-01",
    "settings": { "kill_switch": true, "auto_reconnect": true, "allow_local_network": true }
  },
  "saved": { "last_session_connected": false, "active_server_id": "" },

  "steps": [
    { "at_ms": 0, "input": { "type": "Connect" },
      "effects": [ { "type": "SetGate", "gate": "GATE_ARMED" }, { "type": "StartXray", "server_id": "SRV-01" } ],
      "ui": "verifying",
      "expect": { "phase": "PHASE_STARTING", "gate": "GATE_ARMED" } },
    { "at_ms": 50, "input": { "type": "GateFailed" },
      "effects": [ { "type": "SetGate", "gate": "GATE_DISARMED" }, { "type": "StopXray", "server_id": "SRV-01" } ],
      "ui": "disconnecting",
      "expect": { "phase": "PHASE_STOPPING", "gate": "GATE_DISARMED", "last_failure": "FAILURE_GATE_FAILED" } },
    { "at_ms": 300, "input": { "type": "XrayStopped" },
      "effects": [ { "type": "SaveLastSession", "connected": false, "active_server_id": "" } ],
      "ui": "could_not_reach",
      "expect": { "phase": "PHASE_IDLE", "gate": "GATE_DISARMED", "last_failure": "FAILURE_GATE_FAILED", "last_end": "SESSION_END_COULD_NOT_REACH" } }
  ]
}
