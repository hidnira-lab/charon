{
  "name": "gate fails while blocked",
  "description": "After a boot the service resumes a session that ended connected, with the kill switch on and auto reconnect off, so it goes straight to Blocked with the gate Held. The platform then reports that the gate could not be installed. Xray is not running, so there is nothing to stop: Charon tells the user the tunnel is lost, records that no gate is in place and ends in Idle with the reason gate failed.",

  "config": {
    "version": 1,
    "servers": [
      { "id": "SRV-01", "display_name": "Fixture server one", "protocol": "PROTOCOL_VLESS_REALITY", "address": "192.0.2.10", "port": 443, "uuid": "00000000-0000-0000-0000-000000000001", "flow": "xtls-rprx-vision", "reality": { "public_key": "FIXTURE_PUBLIC_KEY_NOT_A_REAL_KEY", "short_id": "0000", "server_name": "example.com", "fingerprint": "chrome" }, "transport": "tcp", "country_code": "US" },
      { "id": "SRV-02", "display_name": "Fixture server two", "protocol": "PROTOCOL_VLESS_REALITY", "address": "198.51.100.20", "port": 443, "uuid": "00000000-0000-0000-0000-000000000002", "flow": "xtls-rprx-vision", "reality": { "public_key": "FIXTURE_PUBLIC_KEY_NOT_A_REAL_KEY", "short_id": "0000", "server_name": "example.com", "fingerprint": "chrome" }, "transport": "tcp", "country_code": "ID" }
    ],
    "chosen_server_id": "SRV-01",
    "settings": { "kill_switch": true, "auto_reconnect": false, "allow_local_network": true }
  },
  "saved": { "last_session_connected": true, "active_server_id": "SRV-02" },

  "steps": [
    { "at_ms": 0, "input": { "type": "ServiceStarted" },
      "effects": [ { "type": "SetGate", "gate": "GATE_ARMED" }, { "type": "SetGate", "gate": "GATE_HELD" }, { "type": "Notify", "kind": "NOTICE_TRAFFIC_HELD", "server_id": "SRV-02" } ],
      "ui": "blocked",
      "expect": { "phase": "PHASE_BLOCKED", "gate": "GATE_HELD", "active_server_id": "SRV-02", "chosen_server_id": "SRV-01", "on_backup": true } },
    { "at_ms": 50, "input": { "type": "GateFailed" },
      "effects": [ { "type": "Notify", "kind": "NOTICE_TUNNEL_LOST", "server_id": "SRV-02" }, { "type": "SetGate", "gate": "GATE_DISARMED" }, { "type": "SaveLastSession", "connected": false, "active_server_id": "" } ],
      "ui": "tunnel_lost",
      "expect": { "phase": "PHASE_IDLE", "gate": "GATE_DISARMED", "last_failure": "FAILURE_GATE_FAILED", "last_end": "SESSION_END_TUNNEL_LOST" } }
  ]
}
