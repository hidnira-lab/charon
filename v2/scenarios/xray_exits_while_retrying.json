{
  "name": "xray exits while retrying",
  "description": "A session that was Up lost Xray, and Charon is in Retrying. On the first retry Xray starts and then exits again before verification finishes. The documents do not define this. Decided: it counts as one failed try, exactly like a failed verification. The attempt number goes up and the 5 second timer starts again. Xray that will not stay up is not treated as a broken server and does not skip the remaining tries.",

  "config": {
    "version": 1,
    "servers": [
      { "id": "SRV-01", "display_name": "Fixture server one", "protocol": "PROTOCOL_VLESS_REALITY", "address": "192.0.2.10", "port": 443, "uuid": "00000000-0000-0000-0000-000000000001", "flow": "xtls-rprx-vision", "reality": { "public_key": "FIXTURE_PUBLIC_KEY_NOT_A_REAL_KEY", "short_id": "0000", "server_name": "example.com", "fingerprint": "chrome" }, "transport": "tcp", "country_code": "US" }
    ],
    "chosen_server_id": "SRV-01",
    "settings": { "kill_switch": true, "auto_reconnect": true, "allow_local_network": true }
  },
  "saved": { "last_session_connected": false, "active_server_id": "" },

  "steps": [
    { "at_ms": 0, "input": { "type": "Connect" },
      "effects": [ { "type": "SetGate", "gate": "GATE_ARMED" }, { "type": "StartXray", "server_id": "SRV-01" } ],
      "ui": "verifying",
      "expect": { "phase": "PHASE_STARTING", "gate": "GATE_ARMED" } },
    { "at_ms": 600, "input": { "type": "XrayStarted" },
      "effects": [ { "type": "StartVerify", "server_id": "SRV-01" }, { "type": "SetTimer", "name": "verify_timeout", "after_ms": 15000 } ],
      "ui": "verifying",
      "expect": { "phase": "PHASE_VERIFYING", "probe": "PROBE_UNSPECIFIED" } },
    { "at_ms": 2300, "input": { "type": "VerifyOk", "egress_address": "192.0.2.10", "latency_ms": 120 },
      "effects": [ { "type": "CancelTimer", "name": "verify_timeout" }, { "type": "SaveLastSession", "connected": true, "active_server_id": "SRV-01" } ],
      "ui": "connected",
      "expect": { "phase": "PHASE_UP", "gate": "GATE_ARMED", "on_backup": false } },
    { "at_ms": 60000, "input": { "type": "XrayExited" },
      "effects": [ { "type": "SetGate", "gate": "GATE_HELD" }, { "type": "SetTimer", "name": "retry", "after_ms": 5000 }, { "type": "Notify", "kind": "NOTICE_TRAFFIC_HELD", "server_id": "SRV-01" } ],
      "ui": "reconnecting_held",
      "expect": { "phase": "PHASE_RETRYING", "gate": "GATE_HELD", "attempt": 1, "next_try_at_ms": 65000 } },
    { "at_ms": 65000, "input": { "type": "TimerFired", "name": "retry" },
      "effects": [ { "type": "StartXray", "server_id": "SRV-01" } ],
      "ui": "reconnecting_held",
      "expect": { "phase": "PHASE_RETRYING", "attempt": 1, "gate": "GATE_HELD" } },
    { "at_ms": 65600, "input": { "type": "XrayStarted" },
      "effects": [ { "type": "StartVerify", "server_id": "SRV-01" }, { "type": "SetTimer", "name": "verify_timeout", "after_ms": 15000 } ],
      "ui": "reconnecting_held",
      "expect": { "phase": "PHASE_RETRYING", "attempt": 1, "gate": "GATE_HELD" } },
    { "at_ms": 66000, "input": { "type": "XrayExited" },
      "effects": [ { "type": "CancelTimer", "name": "verify_timeout" }, { "type": "StopXray", "server_id": "SRV-01" }, { "type": "SetTimer", "name": "retry", "after_ms": 5000 } ],
      "ui": "reconnecting_held",
      "expect": { "phase": "PHASE_RETRYING", "gate": "GATE_HELD", "attempt": 2, "next_try_at_ms": 71000, "last_failure": "FAILURE_XRAY_EXITED" } }
  ]
}
