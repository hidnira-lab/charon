{
  "name": "tunnel lost, kill switch off, auto reconnect off",
  "description": "The session is Up with the kill switch off and auto reconnect off, and Xray dies. Nothing holds traffic and nothing retries, so traffic goes direct and Charon tells the user the tunnel was lost (the 'Tunnel lost' state on the Home board: 'traffic goes direct, auto reconnect is off'). The phase is Idle, and last_end records that the session was lost, so the app can tell this from a plain disconnect.",

  "config": {
    "version": 1,
    "servers": [
      { "id": "SRV-01", "display_name": "Fixture server one", "protocol": "PROTOCOL_VLESS_REALITY", "address": "192.0.2.10", "port": 443, "uuid": "00000000-0000-0000-0000-000000000001", "flow": "xtls-rprx-vision", "reality": { "public_key": "FIXTURE_PUBLIC_KEY_NOT_A_REAL_KEY", "short_id": "0000", "server_name": "example.com", "fingerprint": "chrome" }, "transport": "tcp", "country_code": "US" }
    ],
    "chosen_server_id": "SRV-01",
    "settings": { "kill_switch": false, "auto_reconnect": false, "allow_local_network": true }
  },
  "saved": { "last_session_connected": false, "active_server_id": "" },

  "steps": [
    { "at_ms": 0, "input": { "type": "Connect" },
      "effects": [ { "type": "StartXray", "server_id": "SRV-01" } ],
      "ui": "verifying",
      "expect": { "phase": "PHASE_STARTING", "gate": "GATE_DISARMED" } },
    { "at_ms": 600, "input": { "type": "XrayStarted" },
      "effects": [ { "type": "StartVerify", "server_id": "SRV-01" }, { "type": "SetTimer", "name": "verify_timeout", "after_ms": 15000 } ],
      "ui": "verifying",
      "expect": { "phase": "PHASE_VERIFYING", "probe": "PROBE_UNSPECIFIED" } },
    { "at_ms": 2300, "input": { "type": "VerifyOk", "egress_address": "192.0.2.10", "latency_ms": 120 },
      "effects": [ { "type": "CancelTimer", "name": "verify_timeout" }, { "type": "SaveLastSession", "connected": true, "active_server_id": "SRV-01" } ],
      "ui": "connected",
      "expect": { "phase": "PHASE_UP", "gate": "GATE_DISARMED", "on_backup": false } },
    { "at_ms": 60000, "input": { "type": "XrayExited" },
      "effects": [ { "type": "Notify", "kind": "NOTICE_TUNNEL_LOST", "server_id": "SRV-01" }, { "type": "SaveLastSession", "connected": false, "active_server_id": "" } ],
      "ui": "tunnel_lost",
      "expect": { "phase": "PHASE_IDLE", "gate": "GATE_DISARMED", "last_failure": "FAILURE_XRAY_EXITED", "last_end": "SESSION_END_TUNNEL_LOST" } }
  ]
}
