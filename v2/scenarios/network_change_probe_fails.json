{
  "name": "network change, probe fails",
  "description": "The session is Up and the device changes network. After the 2 second debounce the probe fails, so the session is treated as one that lost its tunnel: Charon holds traffic and moves to Retrying on the same server. The failed probe counts as attempt 1, so the next try is attempt 2, five seconds later. That try works and the session is Up again. A network change alone never moves the user to another server.",

  "config": {
    "version": 1,
    "servers": [
      { "id": "SRV-01", "display_name": "Fixture server one", "protocol": "PROTOCOL_VLESS_REALITY", "address": "192.0.2.10", "port": 443, "uuid": "00000000-0000-0000-0000-000000000001", "flow": "xtls-rprx-vision", "reality": { "public_key": "FIXTURE_PUBLIC_KEY_NOT_A_REAL_KEY", "short_id": "0000", "server_name": "example.com", "fingerprint": "chrome" }, "transport": "tcp", "country_code": "US" }
    ],
    "chosen_server_id": "SRV-01",
    "settings": { "kill_switch": true, "auto_reconnect": true, "allow_local_network": true }
  },
  "saved": { "last_session_connected": false, "active_server_id": "" },

  "steps": [
    { "at_ms": 0, "input": { "type": "Connect" },
      "effects": [ { "type": "SetGate", "gate": "GATE_ARMED" }, { "type": "StartXray", "server_id": "SRV-01" } ],
      "expect": { "phase": "PHASE_STARTING", "gate": "GATE_ARMED" } },
    { "at_ms": 600, "input": { "type": "XrayStarted" },
      "effects": [ { "type": "StartVerify", "server_id": "SRV-01" }, { "type": "SetTimer", "name": "verify_timeout", "after_ms": 15000 } ],
      "expect": { "phase": "PHASE_VERIFYING" } },
    { "at_ms": 2300, "input": { "type": "VerifyOk", "egress_address": "192.0.2.10", "latency_ms": 120 },
      "effects": [ { "type": "CancelTimer", "name": "verify_timeout" }, { "type": "SaveLastSession", "connected": true, "active_server_id": "SRV-01" } ],
      "expect": { "phase": "PHASE_UP", "gate": "GATE_ARMED" } },
    { "at_ms": 60000, "input": { "type": "NetworkChanged" },
      "effects": [ { "type": "SetTimer", "name": "network_debounce", "after_ms": 2000 } ],
      "expect": { "phase": "PHASE_UP", "gate": "GATE_ARMED" } },
    { "at_ms": 62000, "input": { "type": "TimerFired", "name": "network_debounce" },
      "effects": [ { "type": "StartVerify", "server_id": "SRV-01" }, { "type": "SetTimer", "name": "verify_timeout", "after_ms": 15000 } ],
      "expect": { "phase": "PHASE_VERIFYING", "gate": "GATE_ARMED" } },
    { "at_ms": 62800, "input": { "type": "VerifyFailed", "reason": "FAILURE_NETWORK_CHANGED" },
      "effects": [ { "type": "CancelTimer", "name": "verify_timeout" }, { "type": "StopXray", "server_id": "SRV-01" }, { "type": "SetGate", "gate": "GATE_HELD" }, { "type": "SetTimer", "name": "retry", "after_ms": 5000 }, { "type": "Notify", "kind": "NOTICE_TRAFFIC_HELD", "server_id": "SRV-01" } ],
      "expect": { "phase": "PHASE_RETRYING", "gate": "GATE_HELD", "active_server_id": "SRV-01", "attempt": 2, "next_try_at_ms": 67800, "last_failure": "FAILURE_NETWORK_CHANGED" } },
    { "at_ms": 67800, "input": { "type": "TimerFired", "name": "retry" },
      "effects": [ { "type": "StartXray", "server_id": "SRV-01" } ],
      "expect": { "phase": "PHASE_RETRYING", "attempt": 2 } },
    { "at_ms": 68400, "input": { "type": "XrayStarted" },
      "effects": [ { "type": "StartVerify", "server_id": "SRV-01" }, { "type": "SetTimer", "name": "verify_timeout", "after_ms": 15000 } ],
      "expect": { "phase": "PHASE_RETRYING", "attempt": 2 } },
    { "at_ms": 70000, "input": { "type": "VerifyOk", "egress_address": "192.0.2.10", "latency_ms": 150 },
      "effects": [ { "type": "CancelTimer", "name": "verify_timeout" }, { "type": "SetGate", "gate": "GATE_ARMED" }, { "type": "Notify", "kind": "NOTICE_RECONNECTED", "server_id": "SRV-01" } ],
      "expect": { "phase": "PHASE_UP", "gate": "GATE_ARMED", "on_backup": false, "attempt": 0 } }
  ]
}
