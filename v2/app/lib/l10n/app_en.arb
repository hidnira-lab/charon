{
  "@@locale": "en",
  "appTitle": "Charon",
  "@appTitle": {
    "description": "The title of the application."
  },

  "actionConnect": "Connect",
  "@actionConnect": {
    "description": "Button label to initiate connection."
  },
  "actionDisconnect": "Disconnect",
  "@actionDisconnect": {
    "description": "Button label to disconnect active connection."
  },
  "actionCancel": "Cancel",
  "@actionCancel": {
    "description": "Button label to cancel an ongoing transition."
  },
  "actionRetryNow": "Retry now",
  "@actionRetryNow": {
    "description": "Button label to immediately retry connection."
  },
  "actionRelease": "Release",
  "@actionRelease": {
    "description": "Button label to release held traffic."
  },
  "actionAddServer": "Add a server",
  "@actionAddServer": {
    "description": "Button label when no server is configured."
  },
  "actionSwitchNow": "Switch now",
  "@actionSwitchNow": {
    "description": "Button label to skip retries and switch to backup server."
  },

  "stateConnectedTitle": "Connected",
  "@stateConnectedTitle": {
    "description": "Title when tunnel is connected."
  },
  "stateConnectedBadge": "CONNECTED · VERIFIED",
  "@stateConnectedBadge": {
    "description": "Badge when connection is verified."
  },
