    "description": "Subtitle showing matched egress IP.",
    "placeholders": {
      "ip": { "type": "String" }
    }
  },

  "stateVerifyingTitle": "Verifying handshake",
  "@stateVerifyingTitle": {
    "description": "Title while verifying Reality handshake."
  },
  "stateVerifyingBadge": "VERIFYING",
  "@stateVerifyingBadge": {
    "description": "Badge while verifying."
  },
  "stateVerifyingLine2": "testing a real Reality round trip: {duration}",
  "@stateVerifyingLine2": {
    "description": "Subtitle during verification.",
    "placeholders": {
      "duration": { "type": "String" }
    }
  },

  "stateDisconnectedTitle": "Not connected",
  "@stateDisconnectedTitle": {
    "description": "Title when disconnected."
  },
  "stateDisconnectedBadge": "DISCONNECTED",
  "@stateDisconnectedBadge": {
    "description": "Badge when disconnected."
  },
