{
  "name": "first connect fails verification",
  "description": "The user presses Connect for the first time and the Reality handshake fails. Charon stops with 'Could not reach'. There is no retry loop, even though auto reconnect is on, because retries only apply to a session that has been Up. The gate is Armed while trying and is removed once Xray has stopped.",

  "config": {
    "version": 1,
    "servers": [
      { "id": "SRV-01", "display_name": "Fixture server one", "protocol": "PROTOCOL_VLESS_REALITY", "address": "192.0.2.10", "port": 443, "uuid": "00000000-0000-0000-0000-000000000001", "flow": "xtls-rprx-vision", "reality": { "public_key": "FIXTURE_PUBLIC_KEY_NOT_A_REAL_KEY", "short_id": "0000", "server_name": "example.com", "fingerprint": "chrome" }, "transport": "tcp", "country_code": "US" }
    ],
    "chosen_server_id": "SRV-01",
    "settings": { "kill_switch": true, "auto_reconnect": true, "allow_local_network": true }
  },
  "saved": { "last_session_connected": false, "active_server_id": "" },

  "steps": [
    { "at_ms": 0, "input": { "type": "Connect" },
      "effects": [ { "type": "SetGate", "gate": "GATE_ARMED" }, { "type": "StartXray", "server_id": "SRV-01" } ],
      "expect": { "phase": "PHASE_STARTING", "gate": "GATE_ARMED" } },
    { "at_ms": 600, "input": { "type": "XrayStarted" },
      "effects": [ { "type": "StartVerify", "server_id": "SRV-01" }, { "type": "SetTimer", "name": "verify_timeout", "after_ms": 15000 } ],
      "expect": { "phase": "PHASE_VERIFYING", "gate": "GATE_ARMED" } },
    { "at_ms": 3000, "input": { "type": "VerifyFailed", "reason": "FAILURE_REALITY_HANDSHAKE" },
      "effects": [ { "type": "CancelTimer", "name": "verify_timeout" }, { "type": "StopXray", "server_id": "SRV-01" } ],
      "expect": { "phase": "PHASE_STOPPING", "gate": "GATE_ARMED", "last_failure": "FAILURE_REALITY_HANDSHAKE" } },
    { "at_ms": 3200, "input": { "type": "XrayStopped" },
      "effects": [ { "type": "SetGate", "gate": "GATE_DISARMED" }, { "type": "SaveLastSession", "connected": false, "active_server_id": "" } ],
      "expect": { "phase": "PHASE_IDLE", "gate": "GATE_DISARMED", "last_failure": "FAILURE_REALITY_HANDSHAKE" } }
  ]
}
