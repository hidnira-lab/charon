{
  "name": "retry now from blocked",
  "description": "Auto reconnect is off and the kill switch is on, so when Xray dies the session goes straight to Blocked with the gate Held. The user presses Retry now. Charon starts a fresh attempt on the chosen server at once (no 5 second wait), keeps the gate Held while it tries, and when verification passes it is Up and Armed again.",

  "config": {
    "version": 1,
    "servers": [
      { "id": "SRV-01", "display_name": "Fixture server one", "protocol": "PROTOCOL_VLESS_REALITY", "address": "192.0.2.10", "port": 443, "uuid": "00000000-0000-0000-0000-000000000001", "flow": "xtls-rprx-vision", "reality": { "public_key": "FIXTURE_PUBLIC_KEY_NOT_A_REAL_KEY", "short_id": "0000", "server_name": "example.com", "fingerprint": "chrome" }, "transport": "tcp", "country_code": "US" }
    ],
    "chosen_server_id": "SRV-01",
    "settings": { "kill_switch": true, "auto_reconnect": false, "allow_local_network": true }
  },
  "saved": { "last_session_connected": false, "active_server_id": "" },

  "steps": [
    { "at_ms": 0, "input": { "type": "Connect" },
      "effects": [ { "type": "SetGate", "gate": "GATE_ARMED" }, { "type": "StartXray", "server_id": "SRV-01" } ],
      "expect": { "phase": "PHASE_STARTING", "gate": "GATE_ARMED" } },
    { "at_ms": 600, "input": { "type": "XrayStarted" },
      "effects": [ { "type": "StartVerify", "server_id": "SRV-01" }, { "type": "SetTimer", "name": "verify_timeout", "after_ms": 15000 } ],
      "expect": { "phase": "PHASE_VERIFYING" } },
    { "at_ms": 2300, "input": { "type": "VerifyOk", "egress_address": "192.0.2.10", "latency_ms": 120 },
      "effects": [ { "type": "CancelTimer", "name": "verify_timeout" }, { "type": "SaveLastSession", "connected": true, "active_server_id": "SRV-01" } ],
      "expect": { "phase": "PHASE_UP", "gate": "GATE_ARMED" } },
    { "at_ms": 60000, "input": { "type": "XrayExited" },
      "effects": [ { "type": "SetGate", "gate": "GATE_HELD" }, { "type": "Notify", "kind": "NOTICE_TRAFFIC_HELD", "server_id": "SRV-01" } ],
      "expect": { "phase": "PHASE_BLOCKED", "gate": "GATE_HELD", "last_failure": "FAILURE_XRAY_EXITED" } },
    { "at_ms": 90000, "input": { "type": "RetryNow" },
      "effects": [ { "type": "StartXray", "server_id": "SRV-01" } ],
      "expect": { "phase": "PHASE_RETRYING", "gate": "GATE_HELD", "attempt": 1, "active_server_id": "SRV-01" } },
    { "at_ms": 90600, "input": { "type": "XrayStarted" },
      "effects": [ { "type": "StartVerify", "server_id": "SRV-01" }, { "type": "SetTimer", "name": "verify_timeout", "after_ms": 15000 } ],
      "expect": { "phase": "PHASE_RETRYING", "gate": "GATE_HELD", "attempt": 1 } },
    { "at_ms": 92300, "input": { "type": "VerifyOk", "egress_address": "192.0.2.10", "latency_ms": 125 },
      "effects": [ { "type": "CancelTimer", "name": "verify_timeout" }, { "type": "SetGate", "gate": "GATE_ARMED" }, { "type": "Notify", "kind": "NOTICE_RECONNECTED", "server_id": "SRV-01" } ],
      "expect": { "phase": "PHASE_UP", "gate": "GATE_ARMED", "attempt": 0 } }
  ]
}
