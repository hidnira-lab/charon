{
  "name": "boot, kill switch on, auto reconnect on",
  "description": "The service starts at boot and the last session ended connected, on the backup server SRV-02. Kill switch on and auto reconnect on means Charon holds traffic and reconnects before any UI exists. It resumes on the server that was active (SRV-02), not the chosen one, and counts as a session that has been Up. The resume starts at once with fresh attempts, then verification passes and the gate goes to Armed.",

  "config": {
    "version": 1,
    "servers": [
      { "id": "SRV-01", "display_name": "Fixture server one", "protocol": "PROTOCOL_VLESS_REALITY", "address": "192.0.2.10", "port": 443, "uuid": "00000000-0000-0000-0000-000000000001", "flow": "xtls-rprx-vision", "reality": { "public_key": "FIXTURE_PUBLIC_KEY_NOT_A_REAL_KEY", "short_id": "0000", "server_name": "example.com", "fingerprint": "chrome" }, "transport": "tcp", "country_code": "US" },
      { "id": "SRV-02", "display_name": "Fixture server two", "protocol": "PROTOCOL_VLESS_REALITY", "address": "198.51.100.20", "port": 443, "uuid": "00000000-0000-0000-0000-000000000002", "flow": "xtls-rprx-vision", "reality": { "public_key": "FIXTURE_PUBLIC_KEY_NOT_A_REAL_KEY", "short_id": "0000", "server_name": "example.com", "fingerprint": "chrome" }, "transport": "tcp", "country_code": "ID" }
    ],
    "chosen_server_id": "SRV-01",
    "settings": { "kill_switch": true, "auto_reconnect": true, "allow_local_network": true }
  },
  "saved": { "last_session_connected": true, "active_server_id": "SRV-02" },

  "steps": [
    { "at_ms": 0, "input": { "type": "ServiceStarted" },
      "effects": [ { "type": "SetGate", "gate": "GATE_HELD" }, { "type": "StartXray", "server_id": "SRV-02" } ],
      "ui": "reconnecting_held",
      "expect": { "phase": "PHASE_RETRYING", "gate": "GATE_HELD", "attempt": 1, "active_server_id": "SRV-02", "chosen_server_id": "SRV-01", "on_backup": true } },
    { "at_ms": 600, "input": { "type": "XrayStarted" },
      "effects": [ { "type": "StartVerify", "server_id": "SRV-02" }, { "type": "SetTimer", "name": "verify_timeout", "after_ms": 15000 } ],
      "ui": "reconnecting_held",
      "expect": { "phase": "PHASE_RETRYING", "gate": "GATE_HELD", "attempt": 1 } },
    { "at_ms": 2300, "input": { "type": "VerifyOk", "egress_address": "198.51.100.20", "latency_ms": 90 },
      "effects": [ { "type": "CancelTimer", "name": "verify_timeout" }, { "type": "SetGate", "gate": "GATE_ARMED" }, { "type": "Notify", "kind": "NOTICE_RECONNECTED", "server_id": "SRV-02" } ],
      "ui": "on_backup",
      "expect": { "phase": "PHASE_UP", "gate": "GATE_ARMED", "active_server_id": "SRV-02", "on_backup": true, "attempt": 0 } }
  ]
}
