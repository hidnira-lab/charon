  "@stateReconnectingBadge": {
    "description": "Badge during reconnect attempts.",
    "placeholders": {
      "attempt": { "type": "int" },
      "maxAttempts": { "type": "int" }
    }
  },
  "stateReconnectingLine2": "{server} not answering, next try in {seconds} s",
  "@stateReconnectingLine2": {
    "description": "Subtitle showing countdown to next retry.",
    "placeholders": {
      "server": { "type": "String" },
      "seconds": { "type": "int" }
    }
  },

  "stateReconnectingHeldTitle": "Reconnecting",
  "@stateReconnectingHeldTitle": {
    "description": "Title during auto reconnect with kill switch holding."
